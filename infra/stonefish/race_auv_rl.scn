<?xml version="1.0"?>
<!--
    RL training world for the RACE AUV: the open-water conditions of race2_test.scn (uniform 0.1 m/s current along x,
    flat seabed at 40 m) with the race_auv vehicle (world_of_stonefish jazzy-devel-race-docking-station), so both vehicles
    train under the same conditions. race_auv_test.scn is the ORL tank + docking station: too small for RL episodes.
    Used by infra/launch/race_auv_rl_sim.launch.py.
-->
<scenario>
	<environment>
		<ned latitude="41" longitude="-71"/>
		<ocean>
			<water density="1023.0" jerlov="0.2"/>
			<particles enabled="true"/>
			<current type="uniform">
				<velocity xyz="0.1 0.0 0.0"/>
			</current>
		</ocean>
		<atmosphere>
			<sun azimuth="40.0" elevation="10.0"/>
		</atmosphere>
	</environment>

	<include file="$(find world_of_stonefish)/metadata/materials.scn"/>
	<include file="$(find world_of_stonefish)/metadata/looks.scn"/>
	<include file="$(find world_of_stonefish)/vehicles/race_auv.scn">
		<arg name="robot_name" value="race_auv"/>
	</include>

	<static name="Bottom" type="model">
        <physical>
            <mesh filename="objects/flat_terrain.obj" scale="10.0" convex="true"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </physical>
        <visual>
            <mesh filename="objects/flat_terrain.obj" scale="10.0"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </visual>
        <material name="Rock"/>
        <look name="Gray"/>
        <world_transform xyz="0.0 0.0 40.0" rpy="0.0 0.0 0.0"/>
    </static>
</scenario>
